# Backend development defaults
APP_ENV=development
DATABASE_URL=sqlite:///./mtec_ops.db
AUTO_CREATE_TABLES=true
ENABLE_SEED_DATA=true

# Allow local frontend and direct API calls in development
CORS_ORIGINS=*

# Change this in production
SECRET_KEY=mtec-dev-secret-key

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional runtime services
REDIS_URL=redis://localhost:6379/0

# Legacy discipline / evaluation feature flags
DISCIPLINE_LEGACY_DEPRECATION_HEADER=false
DISCIPLINE_LEGACY_READ_ONLY=false
EVALUATION_LEGACY_MIGRATION_ENABLED=false

# Production example:
# DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/mtec_opsAPP_ENV=development
DATABASE_URL=sqlite:///./mtec_ops.db
AUTO_CREATE_TABLES=true
ENABLE_SEED_DATA=true
CORS_ORIGINS=*

SECRET_KEY=replace-with-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production compose vars
POSTGRES_DB=mtec_ops
POSTGRES_USER=mtec_user
POSTGRES_PASSWORD=replace-with-strong-db-password
UVICORN_WORKERS=2
API_IMAGE=ghcr.io/your-org/mtec-operations-hub-backend:latest
